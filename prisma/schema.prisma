// MK Finance — New Car Website + Dealer + Finance CRM
// Prisma schema — matches CLAUDE.md section 3 & 19 database design
// Local dev uses SQLite (no signup needed). Switch provider to "postgresql"
// and set DATABASE_URL to your Neon connection string for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== IDENTITY & ACCESS ====================

enum UserRole {
  SUPER_ADMIN
  SALES_ADMIN
  FINANCE_ADMIN
  DEALER_MANAGER
  DEALER_EXECUTIVE
  FINANCE_EXECUTIVE
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  mobile       String   @unique
  email        String?
  passwordHash String?
  role         UserRole
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  bankId String?
  bank   Bank?   @relation(fields: [bankId], references: [id])

  dealerExecutiveOf   DealerExecutive?
  dealerManagerOf     DealerManager?
  financeExecutiveOf  FinanceExecutive?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpCodes         OtpCode[]
  leadsAssignedAsDealerExec  Lead[] @relation("LeadDealerExecutive")
  leadsAssignedAsFinanceExec Lead[] @relation("LeadFinanceExecutive")
  followUps        FollowUp[]
  activities       Activity[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  sentMessages     Message[] @relation("MessageSender")
}

// Mobile OTP — dev mode: code is returned in the API response / logged to
// console instead of sent via SMS gateway. Wire up MSG91/Twilio here later.
model OtpCode {
  id        String   @id @default(cuid())
  mobile    String
  code      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ==================== CATALOGUE ====================

model Brand {
  id      String  @id @default(cuid())
  name    String  @unique
  logoUrl String?
  status  String  @default("ACTIVE")

  models Model[]
  leads  Lead[]
  offers Offer[]
}

model Model {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])
  name    String
  // CAR, TRUCK, TEMPO, PICKUP, TRACTOR, BUS, CONSTRUCTION
  category String @default("CAR")
  status  String @default("ACTIVE")

  variants Variant[]
  leads    Lead[]
  offers   Offer[]
}

model Variant {
  id               String  @id @default(cuid())
  modelId          String
  model            Model   @relation(fields: [modelId], references: [id])
  name             String
  fuelType         String
  transmission     String
  exShowroomPrice  Float
  featuresJson     String? // JSON string (SQLite has no native Json type) — superseded by VariantFeature, kept for backward compat
  specsJson        String?

  vehicles        Vehicle[]
  leads           Lead[]
  fieldValues     FieldValue[]
  variantFeatures VariantFeature[]
  prices          VariantPrice[]
  offers          Offer[]
  warranty        Warranty?
  submissions     CarDataSubmission[]
}

model Vehicle {
  id              String  @id @default(cuid())
  variantId       String
  variant         Variant @relation(fields: [variantId], references: [id])
  colourOptionsJson String? // superseded by VehicleColour, kept for backward compat
  imagesJson      String?
  isActive        Boolean @default(true)

  vehicleColours VehicleColour[]
}

// ==================== DYNAMIC FIELD SYSTEM ====================
// Lets Admin define new car specifications/features at runtime — no DB
// migration or frontend code change needed for a new spec to appear.

model FieldCategory {
  id           String @id @default(cuid())
  name         String @unique // e.g. "Safety", "Comfort", "Engine"
  displayOrder Int    @default(0)
  status       String @default("ACTIVE") // ACTIVE | ARCHIVED

  fields FieldDefinition[]
}

model FieldDefinition {
  id         String        @id @default(cuid())
  categoryId String
  category   FieldCategory @relation(fields: [categoryId], references: [id])

  name  String // display name, e.g. "Number of Airbags"
  key   String @unique // machine key, e.g. "airbags_count"
  alias String? // comma-separated synonyms for brochure-matching later

  // TEXT, LONG_TEXT, INTEGER, NUMBER, DECIMAL, BOOLEAN, SELECT, MULTI_SELECT,
  // CURRENCY, PERCENTAGE, DATE, VALUE_UNIT, IMAGE, URL
  dataType String

  unit String? // e.g. "mm", "kg", "PS", "Nm"

  customerVisible   Boolean @default(true)
  filterEnabled     Boolean @default(false)
  comparisonEnabled Boolean @default(false)
  required          Boolean @default(false)
  displayOrder      Int     @default(0)
  status            String  @default("ACTIVE") // ACTIVE | ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options FieldOption[]
  values  FieldValue[]
}

model FieldOption {
  id           String          @id @default(cuid())
  fieldId      String
  field        FieldDefinition @relation(fields: [fieldId], references: [id])
  label        String
  value        String
  displayOrder Int             @default(0)
}

model FieldValue {
  id        String          @id @default(cuid())
  fieldId   String
  field     FieldDefinition @relation(fields: [fieldId], references: [id])
  variantId String
  variant   Variant         @relation(fields: [variantId], references: [id])

  valueText    String?
  valueNumber  Float?
  valueBoolean Boolean?

  // STANDARD, OPTIONAL, NOT_AVAILABLE, PACKAGE, ACCESSORY
  applicability String @default("STANDARD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fieldId, variantId])
}

// ==================== FEATURE & COLOUR LIBRARIES ====================
// Reusable, admin-managed lists — the same Feature/Colour is picked (not
// retyped) across every variant/vehicle that has it, so "Sunroof" or "Pearl
// White" is one record, one spelling, one place to fix a typo.

model Feature {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String? // free-text grouping, e.g. "Safety", "Comfort", "Infotainment"
  icon      String? // optional emoji/short icon identifier
  status    String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt DateTime @default(now())

  variantFeatures VariantFeature[]
}

model VariantFeature {
  id            String  @id @default(cuid())
  variantId     String
  variant       Variant @relation(fields: [variantId], references: [id])
  featureId     String
  feature       Feature @relation(fields: [featureId], references: [id])
  applicability String  @default("STANDARD") // STANDARD | OPTIONAL | NOT_AVAILABLE

  createdAt DateTime @default(now())

  @@unique([variantId, featureId])
}

model Colour {
  id        String   @id @default(cuid())
  name      String   @unique
  hexCode   String
  type      String   @default("EXTERIOR") // EXTERIOR | INTERIOR
  status    String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt DateTime @default(now())

  vehicleColours VehicleColour[]
}

model VehicleColour {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  colourId  String
  colour    Colour  @relation(fields: [colourId], references: [id])
  imageUrl  String?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([vehicleId, colourId])
}

// ==================== CITY / DEALER-WISE PRICING ====================
// Full price history — never updated or deleted, only ever inserted. The
// "current" price for a variant is resolved by specificity: a dealer-
// specific row wins, then a city-level row (dealerId null), then a global
// override row (both dealerId and city null), then finally the base
// Variant.exShowroomPrice as the ultimate fallback so pricing always
// resolves to *something* even before anyone sets up city/dealer pricing.
model VariantPrice {
  id        String  @id @default(cuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])

  dealerId String? // set = dealer-specific price
  dealer   Dealer? @relation(fields: [dealerId], references: [id])
  city     String? // set (and dealerId null) = city-level price

  exShowroomPrice  Float
  rtoCharges       Float?
  insuranceCharges Float?

  effectiveFrom DateTime @default(now())
  createdBy     String?
  createdAt     DateTime @default(now())
}

// ==================== OFFERS & WARRANTY ====================

model Offer {
  id          String @id @default(cuid())
  title       String
  description String?

  discountType  String // FLAT | PERCENTAGE
  discountValue Float

  // Scope — whichever is set applies; leave all three blank for a
  // storewide offer. Checked most-specific first: variant > model > brand.
  brandId   String?
  brand     Brand?  @relation(fields: [brandId], references: [id])
  modelId   String?
  model     Model?  @relation(fields: [modelId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])

  validFrom DateTime
  validTo   DateTime
  status    String   @default("ACTIVE") // ACTIVE | ARCHIVED — separate from expiry, which is date-driven

  createdBy String?
  createdAt DateTime @default(now())
}

// One warranty spec per variant — manufacturer/dealer coverage info shown
// on the car detail page, kept separate from Quotation.extraWarranty (which
// is a specific per-deal charge line-item, not the spec itself).
model Warranty {
  id        String  @id @default(cuid())
  variantId String  @unique
  variant   Variant @relation(fields: [variantId], references: [id])

  standardYears Int
  standardKm    Int
  extendedOptionsJson String? // JSON array of {label, price} extended-warranty packages on offer

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ==================== DRAFT → APPROVE → PUBLISH WORKFLOW ====================
// A Dealer Executive's car-data edit never goes live directly — it's stored
// here as PENDING, and only actually applied to the real tables (FieldValue,
// VariantFeature, VehicleColour, Warranty, ...) once an Admin approves it.
// One generic queue for every change type, rather than a separate draft
// column bolted onto each live table — keeps the Approval Center to one
// screen and keeps every other module's direct-edit path (used by Admins)
// completely untouched.
model CarDataSubmission {
  id        String  @id @default(cuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])

  changeType  String // FIELD_VALUES | FEATURES | COLOURS | WARRANTY
  payloadJson String // proposed new state, same shape the live PUT endpoint for that type expects
  summary     String? // short human-readable description of what's being proposed, for the queue list

  status String @default("PENDING") // PENDING | APPROVED | REJECTED

  submittedBy String
  reviewedBy  String?
  reviewNotes String?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
}

// ==================== SITE CONTENT (ADMIN-EDITABLE) ====================
// Generic key-value content store — lets admin edit site-wide text, rates,
// labels etc. from an admin screen without a code change or redeploy.

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  group     String   @default("general")
  valueJson String
  updatedAt DateTime @updatedAt
}

// Configurable SLA rules (e.g. first-contact window, same-day-deal target)
// — admin-editable hours per named rule, instead of hardcoded constants.
model SlaConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  hours     Int
  updatedAt DateTime @updatedAt
}

// ==================== RBAC: database-driven permissions ====================
// UserRole (fixed enum, unchanged) still decides identity/what a person IS.
// Permission + RolePermission decide what each role can DO — admin-editable
// without a redeploy. Modules migrate to this incrementally (see
// PermissionsGuard); anything not yet migrated keeps using the older
// hardcoded @Roles() decorator, so nothing breaks mid-migration.
model Permission {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  module    String // groups permissions in the admin UI, e.g. "Leads"
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id             String     @id @default(cuid())
  role           String
  permissionCode String
  permission     Permission @relation(fields: [permissionCode], references: [code])
  createdAt      DateTime   @default(now())

  @@unique([role, permissionCode])
}

// ==================== CUSTOMER & LEAD ====================

model Customer {
  id         String   @id @default(cuid())
  name       String
  mobile     String   @unique
  whatsapp   String?
  city       String?
  email      String?
  otpVerified Boolean @default(false)
  createdAt  DateTime @default(now())

  leads Lead[]
  messages Message[]
}

model LostReason {
  id    String @id @default(cuid())
  label String @unique

  leads Lead[]
}

model Lead {
  id      String @id @default(cuid())
  leadCode String @unique // format CAR-2026-000001

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  modelId   String?
  model     Model?   @relation(fields: [modelId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])

  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  dealerExecutiveId String?
  dealerExecutive   User?  @relation("LeadDealerExecutive", fields: [dealerExecutiveId], references: [id])

  financeExecutiveId String?
  financeExecutive   User?  @relation("LeadFinanceExecutive", fields: [financeExecutiveId], references: [id])

  bankId String?
  bank   Bank?  @relation(fields: [bankId], references: [id])

  // Locked pipeline sequence (CLAUDE.md section 9)
  salesStatus String @default("NEW")
  // NEW, CONTACTED, QUALIFIED, INTERESTED, TEST_DRIVE, QUOTATION,
  // NEGOTIATION, BOOKING, DELIVERY, CLOSED, HOLD, LOST

  // Separate finance pipeline (CLAUDE.md section 11)
  financeStatus String @default("NOT_REQUIRED")
  // NOT_REQUIRED, PENDING, DOCUMENTS, LOGIN, VERIFICATION, BANK_QUERY,
  // QUERY_RESOLVED, SANCTION, AGREEMENT, DISBURSEMENT, FINANCE_COMPLETED

  source                String  @default("WEBSITE")
  budget                Float?
  financeRequired       Boolean @default(false)
  expectedPurchaseDate  DateTime?
  isHold                Boolean @default(false)
  isLost                Boolean @default(false)
  lostReasonId          String?
  lostReason            LostReason? @relation(fields: [lostReasonId], references: [id])

  // ---- Phase A: Customer Qualification + Lead Temperature ----
  temperature           String  @default("WARM") // HOT, WARM, COLD — staff-set, no auto-scoring
  purpose               String? // Family, Personal, Business, Other
  enquiryType           String? // VEHICLE_ENQUIRY, FINANCE, INSURANCE, EXCHANGE, TEST_DRIVE, DEALER_ENQUIRY, USED_VEHICLE — which CTA the customer used, for CRM filtering/reporting (separate from purpose above)
  decisionMaker         String?
  currentCar            String?
  exchangeValue         Float?
  customerPriority      String? // Price, Features, Mileage, Safety, Performance, DeliveryTime, Colour
  fuelPreference        String?
  transmissionPreference String?
  colourPreference      String?
  specialRequirements   String?
  customerNotes         String?

  // ---- Phase D: Deal Closure metadata ----
  closedAt DateTime?
  closedBy String?

  // ---- Deal Command Bar: shared Next Action + Blocker ----
  nextAction        String?
  nextActionOwner   String?
  nextActionDueAt   DateTime?
  blocker           String?
  blockerCategory   String?

  // ---- Same-Day Deal Mode ----
  sameDayDeal        Boolean   @default(false)
  sameDayDealStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments        Assignment[]
  followUps          FollowUp[]
  activities         Activity[]
  quotations         Quotation[]
  negotiations       Negotiation[]
  financeApplications FinanceApplication[]
  testDrives         TestDrive[]
  documents          Document[]
  financeCase        FinanceCase?
  booking            Booking?
  delivery           Delivery?
  messages           Message[]
}

// ==================== DEALER STRUCTURE ====================

model Dealer {
  id      String  @id @default(cuid())
  name    String
  brandId String?
  address String?
  city    String?
  phone   String?
  email   String?
  status  String  @default("ACTIVE")

  branches   DealerBranch[]
  managers   DealerManager[]
  executives DealerExecutive[]
  users      User[]
  leads      Lead[]
  dealerBanks DealerBank[]
  variantPrices VariantPrice[]
}

model DealerBank {
  id       String @id @default(cuid())
  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])
  bankId   String
  bank     Bank   @relation(fields: [bankId], references: [id])

  @@unique([dealerId, bankId])
}

model DealerBranch {
  id       String @id @default(cuid())
  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])
  name     String
  address  String?
  city     String?

  executives DealerExecutive[]
}

model DealerManager {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])
}

model DealerExecutive {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  dealerId String
  dealer   Dealer  @relation(fields: [dealerId], references: [id])
  branchId String?
  branch   DealerBranch? @relation(fields: [branchId], references: [id])
}

// ==================== BANK / NBFC STRUCTURE ====================

model Bank {
  id     String  @id @default(cuid())
  name   String
  phone  String?
  email  String?
  status String  @default("ACTIVE")

  branches   BankBranch[]
  executives FinanceExecutive[]
  users      User[]
  leads      Lead[]
  financeCases FinanceCase[]
  dealerBanks DealerBank[]
  financeApplications FinanceApplication[]
}

// ---- Priority B: Multi-Bank Applications — a Finance Executive can shop a
// lead's finance requirement to several banks in parallel before settling
// on one and creating the actual FinanceCase with that bank.
model FinanceApplication {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id])
  bankId            String
  bank              Bank     @relation(fields: [bankId], references: [id])
  applicationNumber String?
  loginDate         DateTime?
  loanAmount        Float?
  tenureMonths      Int?
  status            String   @default("LOGIN_PENDING") // LOGIN_PENDING, LOGIN_DONE, QUERY, SANCTION, REJECTED, WITHDRAWN
  executiveId       String?
  notes             String?
  createdAt         DateTime @default(now())
}

model BankBranch {
  id                 String @id @default(cuid())
  bankId             String
  bank               Bank   @relation(fields: [bankId], references: [id])
  name               String
  city               String?
  serviceArea        String?
  vehicleEligibilityJson String?

  executives FinanceExecutive[]
}

model FinanceExecutive {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  bankId   String
  bank     Bank    @relation(fields: [bankId], references: [id])
  branchId String?
  branch   BankBranch? @relation(fields: [branchId], references: [id])
}

// ==================== WORKFLOW ENTITIES ====================

model Assignment {
  id                 String   @id @default(cuid())
  leadId             String
  lead               Lead     @relation(fields: [leadId], references: [id])
  dealerExecutiveId  String?
  financeExecutiveId String?
  assignedBy         String
  assignedAt         DateTime @default(now())
}

model FollowUp {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String   // Call, WhatsApp, Meeting, Test Drive, Dealer Visit
  result         String   // Interested, Very Interested, Price Issue, Finance Issue, Waiting, Not Interested, Call Later
  notes          String?
  nextFollowUpAt DateTime
  createdAt      DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  metaJson  String?
  createdAt DateTime @default(now())
}

model Quotation {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id])
  price         Float
  onRoadPrice   Float
  exchangeValue Float?
  validTill     DateTime
  createdAt     DateTime @default(now())

  // ---- Phase B: itemized breakdown + versioning ----
  version           Int     @default(1)
  createdBy         String?
  exShowroomPrice   Float?
  rto               Float?
  insurance         Float?
  accessories       Float?
  otherCharges      Float?
  discount          Float?
  exchangeBonus     Float?
  dealerOffer       Float?
  manufacturerOffer Float?
  tcs               Float?
  extraWarranty     Float?
  fastag            Float?
  crtmCharges       Float?
  rsa               Float?
}

// ---- Phase B: Negotiation ----
model Negotiation {
  id                    String   @id @default(cuid())
  leadId                String
  lead                  Lead     @relation(fields: [leadId], references: [id])
  customerExpectedPrice Float?
  dealerOfferedPrice    Float?
  discountRequested     Float?
  discountApproved      Float?
  exchangeValueOffered  Float?
  accessoriesOffered    String?
  specialOffer          String?
  requiresApproval      Boolean  @default(false)
  approvalStatus        String   @default("NOT_REQUIRED") // NOT_REQUIRED, PENDING, APPROVED, REJECTED
  approvedBy            String?
  notes                 String?
  createdBy             String
  createdAt             DateTime @default(now())
}

model TestDrive {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
  scheduledAt DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  feedback    String?
}

model Document {
  id               String    @id @default(cuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id])
  type             String    // Aadhaar, PAN, Address Proof, Income Proof, Bank Statement, ITR, GST, etc.
  fileUrl          String
  status           String    @default("PENDING") // PENDING, UPLOADED, VERIFIED, REJECTED
  rejectionReason  String?
  version          Int       @default(1)
  uploadedBy       String
  verifiedBy       String?
  createdAt        DateTime  @default(now())

  // ---- Whose document this is — a finance case may need docs from the
  // applicant AND a co-applicant AND a guarantor, each kept distinct.
  personType String  @default("APPLICANT") // APPLICANT, CO_APPLICANT, GUARANTOR
  personName String? // e.g. "Priya Patel" — lets you tell multiple co-applicants/guarantors apart
}

model FinanceCase {
  id                  String   @id @default(cuid())
  leadId              String   @unique
  lead                Lead     @relation(fields: [leadId], references: [id])
  bankId              String
  bank                Bank     @relation(fields: [bankId], references: [id])
  financeExecutiveId  String
  loanAmount          Float
  downPayment         Float
  tenureMonths        Int
  roi                 Float
  emi                 Float
  processingFee       Float?
  otherChargesJson    String?
  stage               String   @default("PENDING")
  createdAt           DateTime @default(now())

  statusHistory FinanceStatusHistory[]
  bankQueries   BankQuery[]
}

// ---- Phase B: structured Bank Query (separate from generic FollowUp/Activity) ----
model BankQuery {
  id                String    @id @default(cuid())
  financeCaseId     String
  financeCase       FinanceCase @relation(fields: [financeCaseId], references: [id])
  query             String
  requestedDocument String?
  dueDate           DateTime?
  status            String    @default("OPEN") // OPEN, RESOLVED
  createdBy         String
  resolvedBy        String?
  resolutionNotes   String?
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
}

model FinanceStatusHistory {
  id            String      @id @default(cuid())
  financeCaseId String
  financeCase   FinanceCase @relation(fields: [financeCaseId], references: [id])
  fromStage     String
  toStage       String
  changedBy     String
  notes         String?
  createdAt     DateTime    @default(now())
}

model Booking {
  id            String   @id @default(cuid())
  leadId        String   @unique
  lead          Lead     @relation(fields: [leadId], references: [id])
  bookingAmount Float
  bookedAt      DateTime @default(now())
  bookedBy      String
}

model Delivery {
  id           String    @id @default(cuid())
  leadId       String    @unique
  lead         Lead      @relation(fields: [leadId], references: [id])
  scheduledAt  DateTime
  deliveredAt  DateTime?
  status       String    @default("SCHEDULED") // SCHEDULED, DELIVERED, DELAYED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  channel   String   @default("IN_APP") // IN_APP, EMAIL, SMS, WHATSAPP
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id])
  senderUserId    String?
  sender          User?    @relation("MessageSender", fields: [senderUserId], references: [id])
  senderCustomerId String?
  senderCustomer  Customer? @relation(fields: [senderCustomerId], references: [id])
  recipientUserId String?
  body            String
  customerVisible Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String
  beforeJson String?
  afterJson  String?
  createdAt DateTime @default(now())
}
